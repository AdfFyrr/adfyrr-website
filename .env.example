# Copy this file to .env and fill it in for LOCAL TESTING ONLY.
# .env is gitignored — never commit it, never paste its contents into chat.
# Production values belong in Vercel → Settings → Environment Variables.

# Use your TEST keys here (rzp_test_...). scripts/test-razorpay.js refuses to
# run with live keys, so you cannot accidentally touch real money.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Where buyers are sent after a verified payment.
PLAYBOOK_DOWNLOAD_URL=https://example.com/your-deliverables-link

# Set when you create the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=whsec_choose_something_long_and_random

# Optional: Zapier / Make / n8n URL that emails the buyer their download link.
# Leave blank to just log paid orders in Vercel.
FULFILMENT_WEBHOOK_URL=
